# Neon (required)
DATABASE_URL=
# NEON_DATABASE_URL=   # alias also accepted
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_BASE_URL=http://localhost:3000
NEON_DATA_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (required for real card escrow + bank payouts)
# Without these, funding uses ledger escrow and cashouts stay on-ledger.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — claim / offer emails (without these, notifications still store in-app)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
