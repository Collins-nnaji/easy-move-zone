# Neon (required)
DATABASE_URL=
# NEON_DATABASE_URL=   # alias also accepted
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_BASE_URL=http://localhost:3000
NEON_DATA_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (required for real card escrow + bank payouts)
# Without these, funding uses ledger escrow and cashouts stay on-ledger.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — claim / offer emails (without these, notifications still store in-app)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional — SMS alerts via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Optional — Web Push (VAPID). Public key can also be NEXT_PUBLIC_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@easymovezone.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional — error monitoring (Sentry-compatible DSN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Launch-readiness integrations (see docs/launch-readiness-ui-integrations.md)
# All optional today — /api/health/integrations reports which are configured.
# ---------------------------------------------------------------------------

# Payments (Nigeria) — Paystack / Flutterwave for naira collection + bank payouts.
# Stripe cannot pay out to Nigerian banks; set PAYMENTS_PROVIDER to switch rails.
PAYMENTS_PROVIDER=stripe               # stripe | paystack | flutterwave
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Maps & routing — Mapbox (route line, ETA, geocoding) instead of static OSM embed
MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Realtime (live tracking + driver/fleet chat) — pick one
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
# or ABLY_API_KEY=

# KYC / identity — NIN / BVN / licence verification (pick one)
DOJAH_APP_ID=
DOJAH_API_KEY=
# or SMILE_PARTNER_ID= / SMILE_API_KEY=

# Object storage for the compliance vault (pick one) — replaces base64-in-Postgres
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# or BLOB_READ_WRITE_TOKEN= (Vercel Blob) / S3_* (AWS)

# Neon Object Storage (S3-compatible) — listing photos
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=easymovesone-media

# Local SMS / OTP for Nigeria delivery (pick one) — preferred over Twilio in-market
TERMII_API_KEY=
# or AT_API_KEY= / AT_USERNAME= (Africa's Talking)

# Product analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ---------------------------------------------------------------------------
# Native mobile apps (iOS App Store + Google Play) — see MOBILE.md
# ---------------------------------------------------------------------------
# URL the native shell loads. Defaults to NEXT_PUBLIC_APP_URL, then the prod
# domain. Point at staging to build a staging app.
CAP_SERVER_URL=https://easymovezone.com

# Native push (APNs/FCM) via Firebase Cloud Messaging HTTP v1. Values come from
# a Firebase service-account JSON. Without these, token storage still works but
# native delivery is skipped (web push is unaffected).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
