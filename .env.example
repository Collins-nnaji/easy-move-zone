# Neon (required)
DATABASE_URL=
# NEON_DATABASE_URL=   # alias also accepted
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_BASE_URL=http://localhost:3000
NEON_DATA_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (required for real card escrow + bank payouts)
# Without these, funding uses ledger escrow and cashouts stay on-ledger.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — claim / offer emails (without these, notifications still store in-app)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional — SMS alerts via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Optional — Web Push (VAPID). Public key can also be NEXT_PUBLIC_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@easymovezone.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional — error monitoring (Sentry-compatible DSN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
