# Neon (required)
DATABASE_URL=
# NEON_DATABASE_URL=   # alias also accepted
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_BASE_URL= # Neon Console Auth endpoint, https://<endpoint>.neonauth.<region>.aws.neon.tech/<database>/auth
NEON_DATA_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Legacy Stripe settings (unused by moving checkout)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — claim / offer emails (without these, notifications still store in-app)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional — SMS alerts via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=


# Optional — error monitoring (Sentry-compatible DSN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Launch-readiness integrations (see docs/launch-readiness-ui-integrations.md)
# All optional today — /api/health/integrations reports which are configured.
# ---------------------------------------------------------------------------

# Payments (Nigeria) — Paystack / Flutterwave for naira collection + bank payouts.
# Stripe cannot pay out to Nigerian banks; set PAYMENTS_PROVIDER to switch rails.
PAYMENTS_PROVIDER=paystack             # Moving checkout currently implements Paystack
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Maps & routing — Mapbox (route line, ETA, geocoding) instead of static OSM embed
MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Realtime (live tracking + driver/fleet chat) — pick one
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
# or ABLY_API_KEY=

# KYC / identity — NIN / BVN / licence verification (pick one)
DOJAH_APP_ID=
DOJAH_API_KEY=
# or SMILE_PARTNER_ID= / SMILE_API_KEY=

# Neon Object Storage (S3-compatible) — driver vault + load evidence
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=easymovesone-media
AWS_S3_VAULT_BUCKET=easymovezone-vault

# Optional alternatives — R2 / Vercel Blob
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Local SMS / OTP for Nigeria delivery (pick one) — preferred over Twilio in-market
TERMII_API_KEY=
# or AT_API_KEY= / AT_USERNAME= (Africa's Talking)

# Product analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ---------------------------------------------------------------------------
# Native mobile apps (iOS App Store + Google Play) — see MOBILE.md
# ---------------------------------------------------------------------------
# URL the native shell loads. Defaults to NEXT_PUBLIC_APP_URL, then the prod
# domain. Point at staging to build a staging app.
CAP_SERVER_URL=https://easymovezone.com

# Native push (APNs/FCM) via Firebase Cloud Messaging HTTP v1. Values come from
# a Firebase service-account JSON. Without these, token storage still works but
# native delivery is skipped.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Optional WhatsApp support number in international digits only (e.g. 234...).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Moving marketplace (Paystack checkout is the implemented collection provider)
# Set the Paystack dashboard webhook to /api/payments/webhook.
# PAYSTACK_SECRET_KEY above is also used for x-paystack-signature HMAC validation.
NEXT_PUBLIC_CONTACT_PHONE=
EMZ_LEGAL_NAME=
EMZ_CAC_NUMBER=
EMZ_BUSINESS_ADDRESS=
EMZ_TEAM_DESCRIPTION=
# Approved WhatsApp template: variables 1=move reference, 2=status label
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
# Scheduler POST /api/notifications/process with Authorization: Bearer <secret>
CRON_SECRET=

# Optional OpenAI vision model for photo inventory (Azure uses its configured deployment).
# Must support image inputs and strict JSON schema output.
OPENAI_VISION_MODEL=gpt-4o-mini

# ─── Property site (property/app + property/server at /api/property) ─────────
# Uses DATABASE_URL, the Neon Auth settings and the AWS_* object storage above.
# Property photos, videos and title documents go to AWS_S3_VAULT_BUCKET under
# property/ (private; read through signed URLs). PROPERTY_MEDIA_BUCKET overrides it.
PROPERTY_MEDIA_BUCKET=
# Admin calls are authorised by the admin_users allowlist; this only seeds the
# internal key the API uses for them (defaults to one derived from NEON_AUTH_COOKIE_SECRET).
PROPERTY_ADMIN_SECRET=
# Owner and tenant notices: always in the in-app bell; email via Resend and SMS
# via Termii when set. NOTIFY_STAFF_EMAIL (comma-separated) gets desk alerts.
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_STAFF_EMAIL=
TERMII_API_KEY=
TERMII_SENDER_ID=
# Rent online uses PAYSTACK_SECRET_KEY (above). Keep the one Paystack webhook at
# /api/payments/webhook — rent payments (EMZRENT-…) are passed on from there.
# Schedule POST /api/property-jobs/rent-reminders every 6 hours with
# Authorization: Bearer <CRON_SECRET> for overdue marking and rent reminders.
# Separate signing secret for media delete tokens (defaults to the internal admin key).
MEDIA_TOKEN_SECRET=
# Stripe for Property Passport and renovation milestone payments (optional;
# without it, advisers send payment links by hand).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PASSPORT_PRICE_ID_NGN=

# ─── AI (photo inventory, property photo scan, adviser chat) — use ONE stack ─
# Azure OpenAI:
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
# AZURE_OPENAI_API_KEY=            # alternative name for the key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_CHAT_DEPLOYMENT=    # optional, adviser chat
# AZURE_OPENAI_ANALYSIS_DEPLOYMENT= # optional, deep analysis
# Or api.openai.com:
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_CHAT_MODEL=
# OPENAI_ANALYSIS_MODEL=gpt-4o
# OPENAI_API_VERSION=
# AI_DEBUG_LOG=1                   # log AI requests while debugging

# ─── Optional tunables ──────────────────────────────────────────────────────
NEXT_PUBLIC_CRISP_WEBSITE_ID=      # Crisp chat on the moving page
STRIPE_PRICE_ID_NGN=
STRIPE_PRICE_ID_USD=
# PAYSTACK_API_BASE=https://api.paystack.co
# PG_POOL_MAX=5                    # property API database pool size
# FORCE_SCHEMA=1                   # re-apply the property schema on next start
# RENT_JOBS=off                    # only for a long-running server: disable the in-process rent timer

# ─── Tests only (never set on a deployed server) ───────────────────────────
# TEST_DATABASE_URL=               # a throwaway Postgres for property/server/tests/api.test.js
# AUTH_DEV_USER_HEADER=1           # lets those tests stand in a user with x-dev-user
